# Copy to .env (never commit .env). Anything left empty is simply switched off.
PORT=4000
AYUSH_SECRET=            # long random text; signs sessions and encrypts face templates. Set it in production.
OTP_CODE=                # EMPTY (default) = a different random OTP for every person. Set e.g. 123456 only to force one fixed demo code.
OTP_SHOW=1               # 1 = demo: show the OTP on screen when it was not sent on WhatsApp. 0 = hide it (the OTP is then only on WhatsApp / the server terminal).
FACE_THRESHOLD=0.5       # lower = stricter face match
FACE_REQUIRED=1          # 0 = allow registration without the face step
DEMO_AADHAAR_HINT=1      # 0 = hide the demo Aadhaar chips

# WhatsApp: auto (default: Meta if token set, else Baileys = QR printed in the terminal, else mock) | baileys | meta | mock | off
WHATSAPP_MODE=auto
WHATSAPP_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=ayush-verify
WHATSAPP_APP_SECRET=
# Voice notes on WhatsApp (any OpenAI-compatible transcription endpoint)
STT_URL=
STT_KEY=
STT_MODEL=whisper-1
# Speak & translate page: your own LibreTranslate server (otherwise the free MyMemory service is used)
TRANSLATE_URL=
TRANSLATE_KEY=

# Reads prescription photos / PDFs / handwriting / Hindi sent on WhatsApp (empty = basic offline Tesseract reader, printed English only)
ANTHROPIC_API_KEY=

# WhatsApp voice notes -> text. Leave empty to use the built-in offline Whisper (downloads ~250 MB once on the first voice note).
# Or point STT_URL at any OpenAI-compatible /audio/transcriptions endpoint (STT_KEY, STT_MODEL optional).
# STT_URL=
# STT_LOCAL_MODEL=Xenova/whisper-small
