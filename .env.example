# Copy to .env (never commit .env). Anything left empty is simply switched off.
ANTHROPIC_API_KEY=
# WhatsApp: baileys (scan a QR to link your own number) | meta (official Cloud API) | mock (testing)
WHATSAPP_MODE=baileys
# Needed for the QR on the website when using meta (baileys fills it in automatically): number with country code, digits only
WHATSAPP_NUMBER=
# meta mode only
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=ayush-verify
WHATSAPP_APP_SECRET=
PUBLIC_URL=
